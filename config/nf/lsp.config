params {
  publish_dir_mode = 'link'
  trace_report_suffix = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
}

timeline {
  enabled = true
  file    = "${params.in}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
  enabled = true
  file    = "${params.in}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
  enabled = true
  file    = "${params.in}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}

process {

  maxRetries = 3
  errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'terminate' }

  queue = {
    if (task.time <= 12.h) {
      'short'
    } else if (task.time <= 5.d) {
      'medium'
    } else {
      'long'
    }
  }

  withName: illumination {
    memory = {
      def gpx;
      if (['.rcpnl', '.czi', '.lif'].any{ raw.name.endsWith(it) }) {
        gpx = raw.size() / 2 / 4 / 1e9;
      } else if (raw.name.endsWith('.pysed.ome.tif')) {
        def pth = raw.toRealPath();
        gpx = ['python3', '/n/groups/lsp/mcmicro/tools/o2/ome-tiff-gpx.py', pth].execute().text.toDouble();
      } else {
        gpx = 0;
      }
      def mem = gpx ? (gpx * 5 + 9).GB : 32.GB;
      return mem * task.attempt;
    }
    time   = { 4.h * task.attempt }
    cpus   = 4
  }

  withName: ashlar {
    memory = {
      def raw = lraw[0];
      def gpx;
      if (['.rcpnl', '.czi', '.lif'].any{ raw.name.endsWith(it) }) {
        gpx = raw.size() / 2 / 4 / 1e9;
      } else if (raw.name.endsWith('.pysed.ome.tif')) {
        def pth = raw.toRealPath();
        gpx = ['python3', '/n/groups/lsp/mcmicro/tools/o2/ome-tiff-gpx.py', pth].execute().text.toDouble();
      } else {
        gpx = 0;
      }
      def mem = gpx ? (gpx * 2 + 3.5).GB : 24.GB;
      return mem * task.attempt;
    }
    time   = { 36.h * task.attempt }
    cpus   = 1
  }

  withName: 'segmentation:worker'  {
    memory = {
      def mem;
      if (module.name == 'mccellpose') {
        mem = 6.GB;
      } else if (module.name == 'unmicst') {
        def opts = mcp.options?.unmicst;
        def pth = inp.toRealPath();
        def gpx = (['python3', '/n/groups/lsp/mcmicro/tools/o2/ome-tiff-gpx.py', pth].execute().text ?: '0').toDouble();
        def sfMatch = opts =~ /--scalingFactor\s+(\S+)/;
        def sfLow = sfMatch && sfMatch[0][1].toDouble() <= 0.5;
        def memScale = sfLow ? 30 : 50;
        mem = gpx ? (gpx * memScale + 3).GB : 60.GB;
      }
      else {
        throw new IllegalArgumentException("O2LSP profile does not yet handle segmentation with '${module.name}'");
      }
      return mem * task.attempt;
    }
    time   = { 4.h * task.attempt }
    cpus   = 1
    queue  = {
      def user = System.getenv('USER');
      def qos = "sacctmgr show assoc clusters=o2 user=$user format=qos -P -n".execute().text.strip().split(',')
      def queue = 'gpuquad_qos' in qos ? 'gpu_quad' : 'gpu';
      return queue;
    }
    clusterOptions = '--gres=gpu:1'
  }

  withName: s3seg  {
    memory = {
      def pth = core.toRealPath();
      def gpx = (['python3', '/n/groups/lsp/mcmicro/tools/o2/ome-tiff-gpx.py', pth].execute().text ?: '0').toDouble();
      def versionLarge = module.version.endsWith('-large');
      def memScale = versionLarge ? 8 : 90;
      def memOffset = versionLarge ? 13 : 3;
      def mem = gpx ? (gpx * memScale + memOffset).GB : 60.GB;
      return mem * task.attempt;
    }
    time   = { 12.h * task.attempt }
    cpus   = 1
  }

  withName: mcquant  {
    memory = {
      def pth = task.binding['__$pathinparam<2:1>'].toRealPath();
      def gpx = (['python3', '/n/groups/lsp/mcmicro/tools/o2/ome-tiff-gpx.py', pth].execute().text ?: '0').toDouble();
      def mem = gpx ? (gpx * 8.4 + 5).GB : 60.GB;
      return mem * task.attempt;
    }
    time   = { 6.h * task.attempt }
    cpus   = 1
  }

}
