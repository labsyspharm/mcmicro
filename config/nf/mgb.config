/*
 * Mass General Brigham ERIS Nucleus profile.
 *
 * Observed on erishpc-login-001:
 *   CPU partitions: short (3h), normal (1d), long (7d), bigmem (2d)
 *   GPU partition:  gpu-l40s (8h)
 *   GPU GRES:       gpu:nvidia_l40s:1
 *
 * Dynamic OME-TIFF sizing:
 *   The bundled setup/MGB_ome_tiff_gpx.py script estimates gigapixels from
 *   TIFF/OME-TIFF metadata. Override with --mgb_ome_tiff_gpx_script if needed.
 */

params {
  publish_dir_mode = 'copy'
  trace_report_suffix = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
  mgb_report_dir = params.containsKey('in') ? "${params.in}/pipeline_info" : "pipeline_info"

  mgb_singularity_cache = "$HOME/.mcmicro/singularity"
  mgb_work_dir = "$HOME/scratch/mcmicro-work"
  mgb_gpu_queue = 'gpu-l40s'
  mgb_gpu_gres = 'gpu:nvidia_l40s:1'
  mgb_ome_tiff_gpx_script = "$projectDir/setup/MGB_ome_tiff_gpx.py"
}

singularity.enabled    = true
singularity.autoMounts = true
singularity.cacheDir   = params.mgb_singularity_cache
singularity.pullTimeout = '4h'
singularity.runOptions = '-C -H "$PWD" --nv --env CUDA_VISIBLE_DEVICES="$CUDA_VISIBLE_DEVICES"'

params.contPfx = 'docker://'

timeline {
  enabled = true
  file    = "${params.mgb_report_dir}/execution_timeline_${params.trace_report_suffix}.html"
}
report {
  enabled = true
  file    = "${params.mgb_report_dir}/execution_report_${params.trace_report_suffix}.html"
}
trace {
  enabled = true
  file    = "${params.mgb_report_dir}/execution_trace_${params.trace_report_suffix}.txt"
}

def mgbGpx = { imagePath ->
  def script = params.mgb_ome_tiff_gpx_script
  if (!script) {
    return 0d
  }

  try {
    def scriptFile = new File(script.toString())
    if (!scriptFile.exists()) {
      return 0d
    }

    def txt = ['python3', scriptFile.absolutePath, imagePath.toString()].execute().text.trim()
    return txt ? txt.toDouble() : 0d
  } catch (Exception ignored) {
    return 0d
  }
}

process {

  executor = 'slurm'

  maxRetries = 3
  errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'terminate' }

  cpus   = 4
  time   = '12h'
  memory = '64GB'

  queue = {
    if (task.memory >= 900.GB) {
      'bigmem'
    } else if (task.time <= 3.h) {
      'short'
    } else if (task.time <= 24.h) {
      'normal'
    } else {
      'long'
    }
  }

  withName: illumination {
    memory = {
      def gpx
      if (['.rcpnl', '.czi', '.lif'].any { raw.name.endsWith(it) }) {
        gpx = raw.size() / 2 / 4 / 1e9
      } else if (raw.name.endsWith('.pysed.ome.tif')) {
        gpx = mgbGpx(raw.toRealPath())
      } else {
        gpx = 0
      }

      def mem = gpx ? (gpx * 5 + 9).GB : 32.GB
      return mem * task.attempt
    }
    time = { 4.h * task.attempt }
    cpus = 4
  }

  withName: ashlar {
    memory = {
      def raw = lraw[0]
      def gpx
      if (['.rcpnl', '.czi', '.lif'].any { raw.name.endsWith(it) }) {
        gpx = raw.size() / 2 / 4 / 1e9
      } else if (raw.name.endsWith('.pysed.ome.tif')) {
        gpx = mgbGpx(raw.toRealPath())
      } else {
        gpx = 0
      }

      def mem = gpx ? (gpx * 2 + 3.5).GB : 24.GB
      return mem * task.attempt
    }
    time = { 36.h * task.attempt }
    cpus = 1
  }

  withName: 'segmentation:worker' {
    memory = {
      def mem
      if (module.name.startsWith('mccellpose')) {
        mem = 6.GB
      } else if (module.name == 'unmicst') {
        def opts = mcp.options?.unmicst
        def gpx = mgbGpx(inp.toRealPath())
        def sfMatch = opts =~ /--scalingFactor\s+(\S+)/
        def sfLow = sfMatch && sfMatch[0][1].toDouble() <= 0.5
        def memScale = sfLow ? 30 : 50
        def scaledMem = gpx ? (gpx * memScale + 3).GB : 60.GB
        mem = [scaledMem, 8.GB].max()
      } else {
        mem = 64.GB
      }

      return mem * task.attempt
    }
    time = { task.attempt == 1 ? 4.h : 8.h }
    cpus = 1
    queue = params.mgb_gpu_queue
    clusterOptions = "--gres=${params.mgb_gpu_gres}"
  }

  withName: s3seg {
    memory = {
      def gpx = mgbGpx(core.toRealPath())
      def versionLarge = module.version.endsWith('-large')
      def memScale = versionLarge ? 8 : 90
      def memOffset = versionLarge ? 13 : 3
      def mem = gpx ? (gpx * memScale + memOffset).GB : 60.GB
      return mem * task.attempt
    }
    time = { 12.h * task.attempt }
    cpus = 1
  }

  withName: mcquant {
    memory = {
      def pth = task.binding['__$pathinparam<2:1>'].toRealPath()
      def gpx = mgbGpx(pth)
      def mem = gpx ? (gpx * 8.4 + 5).GB : 60.GB
      return mem * task.attempt
    }
    time = { 6.h * task.attempt }
    cpus = 1
  }
}
